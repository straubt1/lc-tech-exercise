# provider:model passed to init_chat_model, for example openai:gpt-4.1-mini
MODEL=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

MODULE_PATH=

# Module candidate branch. Defaults to latest; main is not reviewed.
MODULE_CANDIDATE_BRANCH=

# Leave unset. Publishing is a later increment and stays off unless this is true.
RELEASE_ENABLED=

PUBLISHER=

# Read by gh from the environment. Never put this in a prompt or in graph state.
GH_TOKEN=

# provider:model for the agents, for example openai:gpt-4.1-mini
# python -m review requires this.
MODEL=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Public module repository. owner/name. Reads send GH_TOKEN when it is set.
GITHUB_REPO=straubt1/terraform-aws-object-storage
# Candidate branch. main is not the candidate.
GITHUB_CANDIDATE_REF=latest

# LangSmith cloud. Tracing stays off until LANGSMITH_TRACING=true and both secrets are set.
LANGSMITH_TRACING=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=terraform-module-review

# Read from the environment for GitHub reads and for the pull-request call. Never put this in a prompt, a tool argument, or graph state.
GH_TOKEN=

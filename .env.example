# provider:model for the agents, for example openai:gpt-4.1-mini
# The stub builds agents but does not call the model, so this can stay empty.
MODEL=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Public module repository. owner/name. No token is required to read it.
GITHUB_REPO=straubt1/terraform-aws-object-storage
# Candidate branch. main is not the release candidate.
GITHUB_CANDIDATE_REF=latest

# LangSmith cloud. Tracing stays off until LANGSMITH_TRACING=true and both secrets are set.
LANGSMITH_TRACING=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=terraform-module-releaser

# Leave unset. The draft release tool is a later increment and stays off unless this is true.
RELEASE_ENABLED=

# Read by the draft release tool from the environment. Never put this in a prompt, a tool argument, or graph state.
GH_TOKEN=
